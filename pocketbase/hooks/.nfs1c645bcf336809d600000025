// Filter checklist-related collections by company_id for multi-tenancy

// 1. Automatically assign company_id from authenticated user on record creation if not provided
onRecordCreate((e) => {
  const collectionName = e.record.collection().name
  const tenantCollections = [
    'checklists',
    'checklist_templates',
    'checklist_item_groups',
    'equipment',
    'materials',
    'clients',
    'users',
    'audit_logs',
  ]

  if (tenantCollections.includes(collectionName)) {
    if (!e.record.get('company_id') && e.auth) {
      const userCompanyId = e.auth.get('company_id')
      if (userCompanyId) {
        if (collectionName === 'audit_logs') {
          if (!e.record.get('company')) {
            e.record.set('company', userCompanyId)
          }
        } else {
          e.record.set('company_id', userCompanyId)
        }
      }
    }
  }

  e.next()
}, 'checklists', 'checklist_templates', 'checklist_item_groups', 'equipment', 'materials', 'clients', 'users', 'audit_logs')

// 2. Intercept List requests to enforce tenant company_id scope
onRecordListRequest((e) => {
  if (e.auth) {
    const userRole = (e.auth.get('role') || '').toLowerCase().trim()
    // Superadmin bypasses company filter
    if (userRole === 'superadmin') {
      e.next()
      return
    }

    const userCompanyId = e.auth.get('company_id')
    const collectionName = e.collection.name

    // If non-superadmin user has no company_id assigned, prevent access
    if (!userCompanyId) {
      e.filter = 'id = "__NONE__"'
      e.next()
      return
    }

    let companyFilter = ''
    if (collectionName === 'audit_logs') {
      companyFilter = `company = '${userCompanyId}'`
    } else if (collectionName === 'checklist_responses') {
      // checklist_responses are scoped via checklist relation
      companyFilter = `checklist_id.company_id = '${userCompanyId}'`
    } else {
      companyFilter = `company_id = '${userCompanyId}'`
    }

    if (e.filter) {
      e.filter = `(${e.filter}) && (${companyFilter})`
    } else {
      e.filter = companyFilter
    }
  }

  e.next()
}, 'checklists', 'clients', 'equipment', 'materials', 'checklist_responses', 'checklist_templates', 'checklist_item_groups')
